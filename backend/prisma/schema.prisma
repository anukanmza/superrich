generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id       Int     @id @default(autoincrement())
  name     String
  phone    String?
  disc     Float?
  color    String?
  tc       String?
  bills    Bill[]
}

model Bill {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])
  total      Float    @default(0)
  createdAt  DateTime @default(now())
  status     String   @default("active")
  entries    Entry[]
}

model Entry {
  id      Int    @id @default(autoincrement())
  billId  Int
  bill    Bill   @relation(fields: [billId], references: [id])
  number  String
  type    String // '2บน', '3บน', etc.
  amount  Float
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String // JSON string
}

model PeriodArchive {
  id        Int      @id @default(autoincrement())
  period    String
  bills     String   // JSON string
  cutouts   String   // JSON string
  results   String   // JSON string
  settings  String   @default("{}") // JSON string of all settings
  createdAt DateTime @default(now())
}

model AiHistoricalData {
  id              Int      @id @default(autoincrement())
  period          String   @unique
  top3            String
  bot2            String
  aiPredictedTop3 String?  // JSON string
  aiPredictedTop2 String?  // JSON string
  aiPredictedBot2 String?  // JSON string
  isHitTop3       Boolean? @default(false)
  isHitTop2       Boolean? @default(false)
  isHitBot2       Boolean? @default(false)
  createdAt       DateTime @default(now())
}

model AiPrediction {
  id            Int      @id @default(autoincrement())
  targetPeriod  String   // The period this prediction was made for
  predictedTop3 String   // JSON array of strings
  predictedTop2 String   // JSON array of strings
  predictedBot2 String   // JSON array of strings
  analysisText  String?  // Store the generated AI analysis response
  createdAt     DateTime @default(now())
}

// ===== Lao lottery AI (separate from Thai tables) =====
model LaoHistoricalData {
  id              Int       @id @default(autoincrement())
  period          String    @unique
  drawDate        DateTime? // parsed from period (dd/mm/yyyy) for ordering
  result4         String    // e.g. "1234"
  top3            String    // last 3 digits  -> "234"
  top2            String    // last 2 digits  -> "34"
  bot2            String    // first 2 digits -> "12"
  predictionId    Int?      // LaoPrediction checked against this result
  aiPredicted4    String?   // JSON [{num,strategy,reason}]
  aiPredictedTop3 String?
  aiPredictedTod3 String?
  aiPredictedTop2 String?
  aiPredictedBot2 String?
  isHit4          Boolean   @default(false)
  isHitTop3       Boolean   @default(false)
  isHitTod3       Boolean   @default(false)
  isHitTop2       Boolean   @default(false)
  isHitBot2       Boolean   @default(false)
  hitDetails      String?   // JSON [{type,num,strategy,reason}]
  createdAt       DateTime  @default(now())
}

model LaoPrediction {
  id            Int      @id @default(autoincrement())
  targetPeriod  String
  predicted4    String   // JSON [{num,strategy,reason}]
  predictedTop3 String
  predictedTod3 String
  predictedTop2 String
  predictedBot2 String
  analysisText  String?
  model         String?
  createdAt     DateTime @default(now())
}
